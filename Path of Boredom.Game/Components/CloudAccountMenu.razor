@inject IGameSession Session
@inject IJSRuntime JS

@if (Session is ICloudGameSession cloud)
{
    <div class="mm-account-body">
        <h2>Keep your ember.</h2>
        <p role="status" aria-live="polite">@cloud.AccountStatus.Message</p>
        @if (lastResult is not null)
        {
            <p role="status" aria-live="polite">@lastResult</p>
        }
        <fieldset disabled="@busy">
            <legend>Google account</legend>
            @if (cloud.AccountStatus.SignedIn)
            {
                <p>Signed in as <strong>@cloud.AccountStatus.Player</strong></p>
                <label class="mm-display-name">Player display name
                    <input @bind="displayName" @bind:event="oninput" maxlength="24" autocomplete="nickname" aria-describedby="nickname-result" />
                </label>
                <small>@PlayerDisplayNameRules.Guidance Your Google name is not required.</small>
                <button type="button" class="mm-pause-option" @onclick="Rename">@(busy ? "Please wait…" : "Save player name")</button>
                <p id="nickname-result" class="mm-name-result" role="status" aria-live="polite">@renameResult</p>
                <button type="button" class="mm-pause-option" @onclick="SignOut">Sign out · keep device save</button>
            }
            else
            {
                <button type="button" class="mm-pause-option" disabled="@(!cloud.AccountStatus.Configured)" @onclick="SignIn">@(cloud.AccountStatus.Deleted ? "Create a new game account with Google" : "Continue with Google")</button>
                @if (cloud.AccountStatus.Deleted)
                {
                    <p>Your previous game data was deleted. Signing in again starts a new account; deleted saves and rankings cannot be restored.</p>
                }
                <p>Offline play needs no account. Only the backend verifies Google identity.</p>
            }
        </fieldset>
        @if (cloud.AccountStatus.SignedIn)
        {
            <fieldset disabled="@busy">
                <legend>Device &amp; cloud saves</legend>
                <p>Save uploads your current run. Load downloads the cloud run. Your device keeps a backup; conflicting changes need your confirmation.</p>
                <p>@(cloud.AccountStatus.CloudRevision is null ? "Cloud availability unknown — refresh to check." : cloud.AccountStatus.CloudSaveExists ? "Cloud save available." : "No cloud save yet — save a run to create one.")</p>
                <button type="button" class="mm-pause-option" @onclick="Refresh">Refresh cloud metadata</button>
                <button type="button" class="mm-pause-option" disabled="@(cloud.AccountStatus.CloudRevision is null)" @onclick="Upload">Upload device save to cloud</button>
                <button type="button" class="mm-pause-option" disabled="@(!cloud.AccountStatus.CloudSaveExists)" @onclick="Download">Use cloud save on this device</button>
                <p>Upload uses the saved device file, not the current unsaved run. Download keeps a device backup; Load then opens the cloud run.</p>
            </fieldset>
            <fieldset disabled="@busy">
                <legend>Delete game account</legend>
                <p>Deletes this account's cloud save and rankings, and this app's device save/backup. It does not delete your Google account. A minimal hashed-ID deletion marker prevents older tokens restoring deleted data.</p>
                <button type="button" class="mm-pause-option mm-danger" @onclick="Delete">Delete game account &amp; saves</button>
            </fieldset>
        }
        <p>Online rankings use client-reported scores and are not cheat-proof.</p>
        @if (confirmation is not null)
        {
            <div class="account-confirm" role="alertdialog" aria-modal="true" aria-label="Confirm save action">
                <h3>Keep your ember safe</h3>
                <p>@confirmation</p>
                <button type="button" class="mm-pause-option" @onclick="() => CompleteConfirmation(true)">Confirm</button>
                <button type="button" class="mm-pause-option" @onclick="() => CompleteConfirmation(false)">Cancel</button>
            </div>
        }
    </div>
}

@code {
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback Deleted { get; set; }
    private CloudAccountStatus? status;
    private bool busy;
    private string? lastResult;
    private string displayName = string.Empty;
    private string? renameResult;
    private string? confirmation;
    private TaskCompletionSource<bool>? confirmationResult;
    private ICloudGameSession Cloud => (ICloudGameSession)Session;

    protected override void OnInitialized() => displayName = Cloud.AccountStatus.SignedIn ? Cloud.AccountStatus.Player : string.Empty;

    private async Task<bool> Confirm(string text)
    {
        confirmation = text;
        confirmationResult = new(TaskCreationOptions.RunContinuationsAsynchronously);
        await InvokeAsync(StateHasChanged);
        return await confirmationResult.Task;
    }

    private void CompleteConfirmation(bool accepted)
    {
        confirmation = null;
        confirmationResult?.TrySetResult(accepted);
    }

    private async Task Run(Func<Task> action)
    {
        if (busy) return;
        busy = true;
        lastResult = null;
        try { await action(); }
        catch
        {
            lastResult = "This operation could not be completed. Device progress is safe; retry when connected.";
            if (renameResult == "Saving player name…") renameResult = lastResult;
        }
        finally { busy = false; }
        await Changed.InvokeAsync();
    }

    private Task SignIn() => Run(async () =>
    {
        renameResult = null;
        status = await Cloud.SignInAsync();
        displayName = status.Player;
    });
    private Task SignOut() => Run(async () =>
    {
        renameResult = null;
        status = await Cloud.SignOutAsync();
        displayName = string.Empty;
    });
    private Task Refresh() => Run(async () => status = await Cloud.RefreshCloudAsync());
    private Task Rename() => Run(async () =>
    {
        if (!PlayerDisplayNameRules.TryNormalize(displayName, out var normalized))
        {
            renameResult = PlayerDisplayNameRules.Guidance;
            return;
        }
        renameResult = "Saving player name…";
        status = await Cloud.ChangeDisplayNameAsync(displayName);
        renameResult = status.Message;
        if (status.SignedIn && status.Player == normalized) displayName = status.Player;
    });
    private Task Upload() => Run(async () =>
    {
        if (!await Confirm("Replace the cloud save with the saved device run? Save your current run first. Changes from another device will not be overwritten.")) return;
        lastResult = (await Cloud.ResolveCloudSaveAsync(false)).Message;
        status = Cloud.AccountStatus;
    });
    private Task Download() => Run(async () =>
    {
        if (!await Confirm("Copy the cloud run to this device? The previous device file is backed up. Choose Load afterwards to play it.")) return;
        lastResult = (await Cloud.ResolveCloudSaveAsync(true)).Message;
        status = Cloud.AccountStatus;
    });
    private Task Delete() => Run(async () =>
    {
        if (!await Confirm("Permanently delete your game saves and rankings, including device backups? This cannot be undone. Your Google account stays unchanged.")) return;
        status = await Cloud.DeleteAccountAsync();
        if (status.Deleted)
        {
            displayName = string.Empty;
            renameResult = null;
            await Deleted.InvokeAsync();
        }
    });
}
