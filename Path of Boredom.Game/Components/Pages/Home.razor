@page "/"
@layout GameLayout
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IGameSession Session
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Path of Boredom - The Ember Campaign</PageTitle>

<div class="arpg" data-player="@windowsUserName" @ref="gameRoot">
    <header class="game-header">
        <a class="brand" href="/" aria-label="Path of Boredom home"><span class="brand-mark">&#9671;</span> PATH <small>OF</small> BOREDOM</a>
        <span class="edition"><span data-stat="mode">THE EMBER CAMPAIGN</span> <span>&middot;</span> <span data-stat="campaign">MAP 1 / 6</span></span>
        <div class="signed-in-user" title="@windowsUserName"><small>WINDOWS SIGN-IN</small><strong>@windowsUserName</strong></div>
        <div class="game-actions">
            <a class="quiet-button" href="/rankings" target="_blank" rel="noopener">Rankings ↗</a>
            <a class="quiet-button" href="/patch-notes" target="_blank" rel="noopener">Patch notes ↗</a>
            <button type="button" class="quiet-button" data-action="forge" disabled>Forge</button>
            <button type="button" class="quiet-button" data-action="save" disabled>Save</button>
            <button type="button" class="quiet-button" data-action="load" disabled>Load</button>
            <button type="button" class="quiet-button" data-action="pause" disabled>Pause <kbd>P</kbd></button>
        </div>
    </header>
    <aside class="patch-notice" data-patch-notice role="status">
        <span><strong>Patch 004 is live — Power Under Pressure</strong> · Growing enemy threats, class-specific trees, Ranger ricochets and piercing, faster loot, and automatic Endless checkpoints. Flasks matter: stage rests are now partial.</span>
        <a href="/patch-notes#patch-004" target="_blank" rel="noopener">Read patch notes ↗</a>
        <button type="button" class="quiet-button" data-dismiss-patch aria-label="Dismiss patch announcement">Dismiss</button>
    </aside>
    <p class="save-status" data-save-status role="status" aria-live="polite">Saves belong to your signed-in Windows account. Checkpoints save automatically; manual Save/Load is also available.</p>
    <p class="save-status" data-ranking-status role="status">@rankingStatus</p>

    <main class="game-shell">
        <section class="chapter-heading" aria-labelledby="chapter-title">
            <div><p class="eyebrow" data-stat="chapter">CHAPTER I / THE LAST EMBER</p><h1 id="chapter-title" data-stat="map">The Ashen Hollow</h1><p data-stat="map-description">The dead are restless. Give them a reason to stay buried.</p></div>
            <div class="run-record"><span data-stat="difficulty">HARD</span><strong data-stat="score">0</strong><span>RUN SCORE · ENEMIES SLAIN</span></div>
        </section>

        <div class="game-grid">
            <section class="arena-section" aria-label="Game arena">
                <div class="combat-view" data-combat-view>
                <div class="arena-toolbar" aria-label="Arena view controls">
                    <span>Scroll protected during combat · Pause to browse</span>
                    <div>
                        <button type="button" class="quiet-button" data-focus-view aria-pressed="false">Focus view</button>
                        <button type="button" class="quiet-button" data-recenter>Recenter</button>
                        <button type="button" class="quiet-button" data-launch-endless disabled>Endless (locked)</button>
                        <button type="button" class="quiet-button" data-open-skills disabled>Skills &amp; loadout</button>
                        <button type="button" class="quiet-button" data-combat-pause disabled>Pause</button>
                    </div>
                </div>
                <div class="arena-topline"><span><i class="live-dot"></i> <span data-stat="objective">Recover six dawns across 30 waves.</span></span><span>WAVE <strong data-stat="wave">&mdash;</strong> / <strong data-stat="last-wave">30</strong></span></div>
                <div class="combat-pressure" data-stat="pressure" aria-label="Current combat pressure">Threat: awaiting a run</div>
                <div class="arena-viewport">
                    <p class="health-warning" data-health-warning role="status" aria-live="polite"></p>
                    <canvas width="1100" height="650" tabindex="0" aria-label="Action RPG arena. WASD or arrows move. J or left click attacks. Q uses your manual skill. Space dodges, E drinks a flask, and P pauses. Up to two combat skills can cast automatically." aria-describedby="game-controls"></canvas>
                    <div class="arena-overlay" data-overlay>
                        <section class="level-draft" data-level-draft hidden aria-labelledby="level-draft-title">
                            <p class="eyebrow" data-stat="draft-level">LEVEL UP</p>
                            <h2 id="level-draft-title">Choose your next oath</h2>
                            <p class="draft-description">Choose one of three. Your boon lasts for this entire run and its save, including the journey into endless mode.</p>
                            <div class="level-card-grid">
                                @for (var index = 0; index < 3; index++)
                                {
                                    <button type="button" class="level-card" data-level-card="@index" disabled>
                                        <span class="card-category" data-card-category></span>
                                        <strong data-card-name></strong>
                                        <span class="card-description" data-card-description></span>
                                        <small data-card-rank></small>
                                        <span class="card-pick">Choose this boon &rarr;</span>
                                    </button>
                                }
                            </div>
                            <p class="draft-footer" data-stat="draft-pending" role="status" aria-live="polite"></p>
                            <small>Combat and timers are paused. Save retains these exact offers; loading will not reroll them.</small>
                        </section>
                        <div class="overlay-card" data-run-menu>
                            <div class="sigil" aria-hidden="true">&#10023;</div>
                            <p class="eyebrow" data-overlay-kicker>SIX DAWNS / ONE LAST PROMISE</p>
                            <h2 data-overlay-title>One blade.<br />One last ember.</h2>
                            <p data-overlay-description>The king rang the Mourning Bell and the sun disappeared. Carry its last spark through six lands. Find your sister. Recover the dawn. Thirty waves, six bosses, then the Endless Watch.</p>
                            <section class="death-report" data-death-report hidden aria-labelledby="death-report-title">
                                <h3 id="death-report-title">What ended this run?</h3>
                                <p data-killing-blow></p>
                                <p>Recent health lost after armor and protection. Up to 12 hits from the last eight seconds of combat; healing is not subtracted.</p>
                                <ol data-damage-history></ol>
                                <small>Invulnerable hits are omitted. This report is session-only and clears when loading or starting a run.</small>
                            </section>
                            <button type="button" class="ember-button" data-action="start" disabled>Begin the journey <span>&rarr;</span></button>
                            <button type="button" class="ember-button endless-button" data-action="endless" hidden>Enter the Endless Watch &rarr;</button>
                            <button type="button" class="quiet-button restart-button" data-action="restart" hidden>Abandon run &amp; restart</button>
                            <small class="unlock-note" data-stat="unlock">Complete the campaign to permanently unlock Endless Watch.</small>
                            <small class="checkpoint-note" data-stat="checkpoint-save"></small>
                            <button type="button" class="ember-button checkpoint-retry" data-retry-save hidden>Retry checkpoint save</button>
                            <small data-loading role="status">Preparing the hollow...</small>
                        </div>
                    </div>
                    <div class="arena-overlay setup-overlay" data-setup hidden role="dialog" aria-modal="true" aria-labelledby="setup-title">
                        <section class="overlay-card">
                            <p class="eyebrow" data-setup-step>PREPARE YOUR JOURNEY</p>
                            <h2 id="setup-title" data-setup-title>Choose your challenge</h2>
                            <p data-setup-description></p>
                            <label class="difficulty-picker" data-setup-difficulty>Difficulty
                                <select data-difficulty aria-describedby="difficulty-description">
                                    <option value="hard">Hard — easiest / recommended start</option>
                                    <option value="nightmare">Nightmare — tougher enemies, less healing</option>
                                    <option value="inferno">Inferno — hardest / least forgiving</option>
                                </select>
                                <small id="difficulty-description" data-difficulty-description aria-live="polite"></small>
                            </label>
                            <label class="difficulty-picker" data-class-picker>Character class
                                <select data-hero-class aria-describedby="class-preview-description">
                                    <option value="knight">Ember Knight — balanced melee</option>
                                    <option value="ranger">Dawn Ranger — ranged skirmisher</option>
                                    <option value="warden">Iron Warden — armored bruiser</option>
                                </select>
                            </label>
                            <section class="class-preview" data-class-preview aria-live="polite">
                                <h3 data-class-title>Ember Knight</h3>
                                <p id="class-preview-description" data-class-description></p>
                                <p data-class-stats></p>
                                <p data-class-skills></p>
                                <small>Base stats before equipment and upgrades. Class stays with the character, including continuation into Endless.</small>
                            </section>
                            <section data-setup-loadout hidden aria-label="Starting skill loadout">
                                <p data-setup-unlock></p>
                                <div class="loadout-grid">
                                    @for (var slot = 0; slot < 3; slot++)
                                    {
                                        <label>@(slot == 0 ? "Manual skill (Q)" : $"Auto slot {slot}")
                                            <select data-setup-slot="@slot">
                                                @if (slot > 0) { <option value="none">Empty</option> }
                                                @foreach (var skill in new[] { "nova", "burst", "guard" })
                                                {
                                                    <option value="@skill" data-setup-skill="@skill">@skill</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                </div>
                                <p class="forge-feedback" data-setup-loadout-feedback role="status"></p>
                            </section>
                            <button type="button" class="ember-button" data-setup-next>Continue</button>
                            <button type="button" class="quiet-button restart-button" data-setup-skip hidden>Skip tips &amp; choose skills</button>
                            <button type="button" class="quiet-button restart-button" data-setup-cancel>Cancel</button>
                        </section>
                    </div>
                    <div class="arena-caption" data-stat="map-caption" aria-hidden="true">THE ASHEN HOLLOW / ASHBOUND SANCTUM</div>
                    <div class="forge-nudge" data-forge-nudge hidden><span data-stat="forge-hint" role="status"></span><button type="button" class="quiet-button" data-open-forge>Open forge</button></div>
                    <div class="forge-nudge skill-unlock-nudge" data-skill-unlock hidden>
                        <span data-stat="skill-unlock-hint" role="status"></span>
                        <button type="button" class="quiet-button" data-slot-unlocked>Slot skill</button>
                        <button type="button" class="quiet-button" data-dismiss-unlock aria-label="Dismiss skill unlock reminder">Later</button>
                    </div>
                </div>
                <div class="power-strip" aria-label="Active timed power-ups"><span>EMBER BLESSINGS</span><strong data-stat="buffs">No active power-ups</strong></div>
                <div class="vitals">
                    <div class="vital"><div><span>VITALITY</span><strong data-stat="health">100 / 100</strong></div><meter data-meter="health" min="0" max="100" value="100" aria-label="Health"></meter></div>
                    <div class="level-medallion"><small>LVL</small><strong data-stat="level">1</strong></div>
                    <div class="vital experience"><div><span>EXPERIENCE</span><strong data-stat="xp">0 / 60</strong></div><meter data-meter="xp" min="0" max="60" value="0" aria-label="Experience"></meter></div>
                </div>
                <div class="skill-bar">
                    @foreach (var skill in new[] { "attack", "nova", "burst", "guard", "dodge", "potion" })
                    {
                        <button type="button" data-skill="@skill"><kbd data-slot-label></kbd><span class="skill-icon">&#10023;</span><span><span data-skill-name="@skill">@skill</span><small data-stat="@skill">Ready</small></span></button>
                    }
                </div>
                <div class="touch-movement" aria-label="Touch movement controls">
                    <button type="button" data-move="up" aria-label="Move up">&uarr;</button>
                    <div><button type="button" data-move="left" aria-label="Move left">&larr;</button><button type="button" data-move="down" aria-label="Move down">&darr;</button><button type="button" data-move="right" aria-label="Move right">&rarr;</button></div>
                </div>
                </div>
                <section class="skills-panel" data-skills aria-labelledby="skills-title">
                    <div class="forge-heading"><h2 id="skills-title">Paths of power</h2><strong data-stat="skill-points">0 points available</strong></div>
                    <p>J or left click is your regular attack; Space dodges and E drinks a flask. These actions never need slots and cannot auto-cast. Choose one combat skill for Q and up to two for auto-casting, with 60% longer cooldowns. Pause to configure. Attacks and all abilities remain upgradeable: earn one point every two levels, up to 32 total—enough to fully upgrade four trees at level 64. Choices stay with this character.</p>
                    <div class="loadout-grid">
                        @for (var slot = 0; slot < 3; slot++)
                        {
                            <label>@(slot == 0 ? "Manual skill (Q)" : $"Auto slot {slot}")
                                <select data-loadout-slot="@slot" disabled>
                                    @if (slot > 0) { <option value="none">Empty</option> }
                                    @foreach (var skill in new[] { "nova", "burst", "guard" })
                                    {
                                        <option value="@skill" data-skill-name="@skill">@skill</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                    <p class="forge-feedback" data-skill-feedback role="status">Only special, burst, and ward skills use slots; no skill can occupy two slots. Regular attacks, dodge, and flasks are always manual. Unsaved changes require Save or the next checkpoint.</p>
                    <p class="skill-unlock-status" data-stat="ward-unlock-status"></p>
                    <p>Reset one tree while paused for 100 gold + 50 per spent point. All points from that tree return; gold is spent permanently. Cooldowns stay unchanged and refunded effects end. Save to keep changes outside checkpoints.</p>
                    <details class="elite-guide">
                        <summary>Elite traits — appearing from wave 11</summary>
                        <p>Some elites carry one trait, shown above their head with a colored symbol.</p>
                        <ul><li>⬡ Armored: takes 20% less damage; no reflection.</li><li>» Swift: walks 18% faster; charges and attack warnings stay unchanged.</li><li>+ Mending: heals 1.5% maximum health per second; focus it down.</li></ul>
                    </details>
                    <button type="button" class="ember-button" data-resume-combat disabled>Return to battle</button>
                    <div class="skill-tree-grid">
                        @foreach (var skill in new[] { "attack", "nova", "burst", "guard", "dodge", "potion" })
                        {
                            <section class="skill-tree" data-tree-skill="@skill">
                                <h3 data-skill-name="@skill">@skill</h3>
                                <p data-skill-description="@skill"></p>
                                <p class="tree-path">Hover or focus for details. On touch, tap to inspect, then tap again to learn. Each rank costs 1 point.</p>
                                <button type="button" class="quiet-button tree-respec" data-respec-tree="@skill" disabled>Reset tree</button>
                                <div class="skill-tree-map" role="group" aria-label="Upgrade branches">
                                    <svg class="tree-connections" viewBox="0 0 300 300" preserveAspectRatio="none" aria-hidden="true">
                                        <path data-tree-link="root-left" d="M150 40 L75 150" />
                                        <path data-tree-link="root-right" d="M150 40 L225 150" />
                                        <path data-tree-link="left-capstone" d="M75 150 L150 260" />
                                        <path data-tree-link="right-capstone" d="M225 150 L150 260" />
                                    </svg>
                                    @foreach (var node in new[] { "root", "left", "right", "capstone" })
                                    {
                                        <div class="tree-node tree-node-@node">
                                            <button type="button" data-learn-skill="@skill" data-tree-slot="@node" aria-disabled="true" aria-describedby="tree-tip-@skill-@node">
                                                <span class="tree-node-icon" data-tree-icon aria-hidden="true">◇</span>
                                                <strong data-tree-name>@node</strong><small data-tree-rank></small>
                                            </button>
                                            <div class="tree-tooltip" id="tree-tip-@skill-@node" role="tooltip">
                                                <span data-tree-detail></span><strong data-tree-status></strong>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                </section>
                <section class="forge-panel" data-forge aria-labelledby="forge-title">
                    <div class="forge-heading">
                        <div>
                            <p class="eyebrow">THE TRAVELING FORGE</p>
                            <h2 id="forge-title">Build your own dawn</h2>
                        </div>
                        <span data-stat="forge-gold">0 gold</span>
                    </div>
                    <button type="button" class="ember-button" data-resume-combat disabled>Return to battle</button>
                    <p class="forge-hint">Gold is your main upgrade source: select Forge to pause and buy ranks. Scrolls are rare elite/boss drops. Max every forge item to unlock unlimited stat training. Purchases at checkpoints autosave; elsewhere, use Save.</p>
                    <p class="forge-hint">Previews show effective current → next values with your present buffs and loadout. Damage is a normal hit before enemy defenses or conditional bonuses; arrow repeats and critical hits are separate. CAPPED means further ranks cannot improve that stat. A capped forge purchase may still be needed to unlock training.</p>
                    <div class="forge-grid">
                        <button type="button" data-upgrade="weapon" disabled><strong>Sunsteel edge</strong><span>Weapon damage</span><small data-upgrade-label="weapon">Rank 0 / 50</small></button>
                        <button type="button" data-upgrade="armor" disabled><strong>Dawnplate</strong><span>Armor + max health</span><small data-upgrade-label="armor">Rank 0 / 12</small></button>
                        <button type="button" data-upgrade="cleave" disabled><strong>Wide awakening</strong><span data-stat="forge-attack">Cleave power, reach, speed</span><small data-upgrade-label="cleave">Rank 0 / 8</small></button>
                        <button type="button" data-upgrade="nova" disabled><strong>Solar heart</strong><span data-stat="forge-special">Nova power, radius, recovery</span><small data-upgrade-label="nova">Rank 0 / 8</small></button>
                        <button type="button" data-upgrade="dodge" disabled><strong>Ghoststep</strong><span>Dodge recovery + immunity</span><small data-upgrade-label="dodge">Rank 0 / 8</small></button>
                        <button type="button" data-upgrade="flask" disabled><strong>Living ember</strong><span>Healing power + flask refill</span><small data-upgrade-label="flask">Rank 0 / 5</small></button>
                        <button type="button" data-upgrade="critChance" disabled><strong>Keen ember</strong><span>+2 percentage points critical chance; 75% total cap</span><small data-upgrade-label="critChance">Rank 0 / 8</small></button>
                        <button type="button" data-upgrade="critDamage" disabled><strong>Ruin's edge</strong><span>+10 percentage points critical damage</span><small data-upgrade-label="critDamage">Rank 0 / 8</small></button>
                        <button type="button" data-upgrade="burst" disabled><strong>Breaking dawn</strong><span data-stat="forge-burst">Class burst damage, range and recovery</span><small data-upgrade-label="burst">Rank 0 / 8</small></button>
                        <button type="button" data-upgrade="guard" disabled><strong>Last sanctuary</strong><span data-stat="forge-guard">Class ward damage, radius, duration and recovery</span><small data-upgrade-label="guard">Rank 0 / 8</small></button>
                    </div>
                    <p class="forge-feedback" data-forge-feedback role="status" aria-live="polite">Every coin is a choice. Damage, survival, or skills?</p>
                    <section class="mastery-panel" data-mastery hidden aria-labelledby="mastery-title">
                        <h3 id="mastery-title">Beyond the forge</h3>
                        <p>Each stat starts at 1,000 gold. Buying a rank adds only 100 gold to that stat's next price; other stats are unaffected. Ranks have no fixed limit, but critical chance caps at 75% and reach at the arena diagonal. Saved with this character.</p>
                        <div class="forge-grid">
                            <button type="button" data-mastery-stat="might" disabled><strong>Ember might</strong><span>+2 base weapon damage</span><small data-mastery-label></small></button>
                            <button type="button" data-mastery-stat="vitality" disabled><strong>Enduring heart</strong><span>+5 max health; heal 5</span><small data-mastery-label></small></button>
                            <button type="button" data-mastery-stat="recovery" disabled><strong>Battle rhythm</strong><span>+0.5% cooldown recovery</span><small data-mastery-label></small></button>
                            <button type="button" data-mastery-stat="area" disabled><strong>Widening ember</strong><span>+1% attack reach and special radius/range</span><small data-mastery-label></small></button>
                            <button type="button" data-mastery-stat="speed" disabled><strong>Endless stride</strong><span>+1% movement speed; dodge distance unchanged</span><small data-mastery-label></small></button>
                            <button type="button" data-mastery-stat="critChance" disabled><strong>Unerring spark</strong><span>+0.5 percentage points critical chance; 75% total cap</span><small data-mastery-label></small></button>
                            <button type="button" data-mastery-stat="critDamage" disabled><strong>Endless ruin</strong><span>+2 percentage points critical damage</span><small data-mastery-label></small></button>
                        </div>
                    </section>
                </section>
            </section>

            <aside class="journey-panel">
                <section class="hero-card"><div class="hero-emblem" aria-hidden="true">&#9876;</div><p class="eyebrow">YOUR EXILE</p><h2 data-stat="hero-class">Ember Knight</h2><p data-stat="hero-role">Balanced melee</p><div class="hero-stats"><div><span>Damage</span><strong data-stat="damage">18</strong></div><div><span>Gold</span><strong class="gold" data-stat="gold">0</strong></div><div><span>Slain</span><strong data-stat="kills">0</strong></div></div><dl class="class-stat-grid"><dt>Movement speed</dt><dd data-stat="class-speed">220</dd><dt>Innate armor</dt><dd data-stat="class-armor">0%</dd><dt>Base attack interval</dt><dd data-stat="class-attack">0.38s</dd><dt>Base dodge recovery</dt><dd data-stat="class-dodge">1.8s</dd><dt>Critical chance</dt><dd data-stat="critical-chance">5%</dd><dt>Critical damage</dt><dd data-stat="critical-damage">150%</dd><dt>Attack reach</dt><dd data-stat="attack-reach">100</dd><dt>Special radius/range</dt><dd data-stat="special-reach">190</dd></dl></section>
                <section class="story-card"><p class="eyebrow" data-stat="story-title">THE FIRST DAWN</p><p data-stat="story">The sun vanished when the king rang the Mourning Bell. Your sister's voice whispers from the lantern: find the six stolen dawns.</p><small data-stat="dawns">0 / 6 dawns recovered</small></section>
                <section class="equipment-card"><p class="eyebrow">ARMS &amp; ARMOR</p><div class="weapon-icon" aria-hidden="true">&#8224;</div><h3 data-stat="weapon">Worn iron blade</h3><p data-stat="weapon-detail">Starter weapon &middot; +0 damage</p><h3 data-stat="armor-name">Traveler's coat</h3><p data-stat="armor-detail">0% damage reduction</p><small>Walk over loot. Better weapons and armor equip automatically; forge bonuses are retained.</small></section>
                <section class="boons-card"><p class="eyebrow">CHOSEN OATHS <span data-stat="boon-count">0</span></p><p data-stat="boons">Level up to choose your first lasting boon.</p><small>Stacking, run-long bonuses. A fresh campaign or fresh endless character starts with none.</small></section>
                <section class="journal-card"><p class="eyebrow">FIELD JOURNAL</p><p data-stat="journal" role="status" aria-live="polite">A faint warmth lingers beneath the ashes.</p></section>
                <section class="controls-card"><p class="eyebrow">PICKUP BLESSINGS</p><dl><dt>Bloodsun / 15s</dt><dd>+50% damage</dd><dt>Windwake / 12s</dt><dd>Speed + recovery</dd><dt>Dawn aegis / 10s</dt><dd>Half damage</dd><dt>Gravetide / 20s</dt><dd>Loot magnet</dd></dl><p>Glowing pickups grant temporary powers. Picking up the same blessing refreshes its timer. Pale scrolls permanently add one upgrade rank to this run.</p></section>
                <section class="controls-card"><p class="eyebrow">THE ROAD AHEAD</p><dl><dt>1-5</dt><dd>Ashen Hollow</dd><dt>6-10</dt><dd>Drowned Wilds</dd><dt>11-15</dt><dd>Cinder Citadel</dd><dt>16-20</dt><dd>Glass Expanse</dd><dt>21-25</dt><dd>Storm Archive</dd><dt>26-30</dt><dd>Starless Gate</dd><dt>After 30</dt><dd>Endless Watch</dd></dl><p data-stat="threat">Husks swarm, brutes strike hard, and wisps attack at range.</p></section>
                <section class="controls-card" id="game-controls"><p class="eyebrow">HOW TO SURVIVE</p><dl><dt>WASD / arrows</dt><dd>Move</dd><dt>Mouse</dt><dd>Aim</dd><dt>J / left click</dt><dd>Regular attack</dd><dt>Q</dt><dd>Selected manual skill</dd><dt>Space / E</dt><dd>Dodge / flask (manual)</dd><dt>Two auto slots</dt><dd>Combat skills only; +60% cooldown</dd><dt>P / Escape</dt><dd>Pause</dd><dt>Skills &amp; loadout</dt><dd>Assign skills / upgrade attacks and abilities</dd><dt>Flask pickups</dt><dd>Carry up to 5</dd></dl><p>Earn an upgrade point every five levels, up to 12. Avoid bright pink-white enemy projectiles, marked attack arcs, and mortar circles. Returning from the forge gives you a countdown.</p></section>
            </aside>
        </div>
        <footer class="game-footer"><span>SIX DAWNS. ONE LAST PROMISE.</span><span>Windows account saves &middot; Checkpoint autosaves &middot; Permanent Endless unlock</span><span class="credit">Developed by MadBone | LIT MES TSR</span></footer>
    </main>
</div>

@code {
    // Reference to the root <div class="arpg"> element — handed to the JS module so it can query
    // everything else it needs (canvas, buttons, overlays) by selector instead of us wiring each
    // one up individually through Blazor's own binding syntax.
    private ElementReference gameRoot;
    // The imported ./js/arpg.js ES module instance, kept around so we can dispose it cleanly.
    private IJSObjectReference? module;
    // The live game instance returned by arpg.js's createGame() — this is what actually owns the
    // render loop, input handling, and game state for as long as this page is open.
    private IJSObjectReference? game;
    // Wraps `this` so JS can call back into our [JSInvokable] methods below (SaveRun/LoadRun/SubmitScore).
    private DotNetObjectReference<Home>? saveBridge;
    // Guards against racing DisposeAsync with an in-flight OnAfterRenderAsync (e.g. if the user
    // navigates away before the JS module finishes importing).
    private bool disposed;
    private string windowsUserName = string.Empty;
    private string rankingStatus = "Connecting to the rankings...";

    /// <summary>
    /// Runs once when the component initializes: reads the signed-in Windows username off the
    /// authenticated principal (domain prefix stripped for a cleaner display), then registers/pings
    /// the rankings profile so the leaderboard has a row for this player before any score is submitted.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        windowsUserName = await Session.GetPlayerNameAsync();
        rankingStatus = await Session.RegisterPlayerAsync()
            ? "Rankings connected. Best kill scores and builds are kept separately by class, difficulty, and starting mode."
            : "Rankings unavailable. Scores will retry during play.";
    }

    /// <summary>
    /// Called by arpg-ranking.js/arpg.js whenever a run ends (or hits a scoring milestone) to
    /// submit the score/build for the leaderboard. Re-reads the current ClaimsPrincipal each call
    /// rather than caching it, so a stale/expired identity can never be reused for a stale request.
    /// </summary>
    [JSInvokable]
    public async Task<bool> SubmitScore(Path_of_Boredom.ServiceDefaults.ScoreSubmission submission) =>
        await Session.SubmitScoreAsync(submission);

    /// <summary>
    /// Called by arpg-save.js whenever the player manually saves, or a checkpoint auto-saves.
    /// The snapshot arrives as a raw JsonElement because Blazor JS interop already deserializes JS
    /// objects into JSON for us — there's no need to define a strongly-typed C# save model here
    /// since this project never actually reads individual save fields, it just forwards the blob.
    /// </summary>
    [JSInvokable]
    public async Task<GameSaveResult> SaveRun(System.Text.Json.JsonElement snapshot) =>
        await Session.SaveAsync(snapshot);

    /// <summary>
    /// Called by arpg.js when the player clicks Load (or the game auto-attempts a load at startup).
    /// </summary>
    [JSInvokable]
    public async Task<GameSaveResult> LoadRun() =>
        await Session.LoadAsync();

    /// <summary>
    /// Fires once, after the component's first render, once the <canvas> and all the static markup
    /// actually exist in the DOM. This is where the entire JS game gets bootstrapped: import the
    /// module, hand it the root element plus a callback bridge to this component, and let it take
    /// over from there. Runs at most once per page load — Blazor won't call this again on
    /// subsequent re-renders because of the `firstRender` guard.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || disposed) return;

        try
        {
            var importedModule = await JS.InvokeAsync<IJSObjectReference>("import", "/_content/PathOfBoredom.Game/js/arpg.js");

            // If the component got disposed while the import was in flight (e.g. fast navigation
            // away), don't leave an orphaned module reference around — clean it up immediately
            // instead of proceeding to create a game nobody will ever see.
            if (disposed)
            {
                await importedModule.DisposeAsync();
                return;
            }

            module = importedModule;
            saveBridge = DotNetObjectReference.Create(this);
            var instance = await module.InvokeAsync<IJSObjectReference>("createGame", gameRoot, saveBridge);

            // Same disposal race, but after the game instance itself was created — make sure its
            // own dispose() is called before tearing down the object reference.
            if (disposed)
            {
                await instance.InvokeVoidAsync("dispose");
                await instance.DisposeAsync();
                return;
            }

            game = instance;
        }
        catch (JSDisconnectedException)
        {
            // The SignalR circuit dropped mid-setup (e.g. browser tab closed during initial JS
            // interop calls) — nothing meaningful to do here, the component is going away anyway.
        }
    }

    /// <summary>
    /// Tears down the JS side cleanly when the page/component goes away: tells the game instance to
    /// dispose itself (stop the render loop, remove event listeners) before disposing the JS object
    /// references themselves, then releases the .NET callback reference. Order matters here — disposing
    /// the module before the game instance has a chance to call dispose() would leave JS-side timers/
    /// listeners dangling until the browser tab itself closes.
    /// </summary>
    public async ValueTask DisposeAsync()
    {
        disposed = true;
        saveBridge?.Dispose();

        try
        {
            if (game is not null)
            {
                await game.InvokeVoidAsync("dispose");
                await game.DisposeAsync();
            }

            if (module is not null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit may already be gone by the time we try to clean up JS-side state (e.g.
            // browser tab closed abruptly) — safe to ignore, there's nothing left to talk to.
        }
    }
}