@page "/"
@layout GameLayout
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IGameSession Session
@inject IServiceProvider Services
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<Microsoft.AspNetCore.Components.Web.PageTitle>Path of Boredom - The Ember Campaign</Microsoft.AspNetCore.Components.Web.PageTitle>

<div class="arpg" data-player="@windowsUserName" data-ranking-board="@(Session is ICloudGameSession ? Path_of_Boredom.ServiceDefaults.RankingRules.MobileRelease : Path_of_Boredom.ServiceDefaults.RankingRules.CurrentPatch)" data-cloud-signed-in="@(Session is ICloudGameSession account && account.AccountStatus.SignedIn ? "on" : "off")" @ref="gameRoot">
    <section class="main-menu" data-main-menu aria-labelledby="main-menu-title">
        <div class="main-menu-card">
            <h1 id="main-menu-title">Path of Boredom</h1>
            <p>Your run stays paused while this menu is open. Save before closing the app.</p>
            <button type="button" class="ember-button" data-main-resume hidden>Continue</button>
            <button type="button" class="quiet-button" data-main-play aria-expanded="false" aria-controls="main-play-menu">Play</button>

            <div class="main-play-menu" id="main-play-menu" data-main-play-menu hidden>
                <button type="button" class="quiet-button" data-main-new>Campaign</button>
                <button type="button" class="quiet-button" data-main-endless hidden>Endless</button>
                <button type="button" class="quiet-button" data-main-load>Load saved run</button>
                <button type="button" class="quiet-button" data-close-play-menu>Back</button>
            </div>

            <button type="button" class="quiet-button" data-open-camp>Account Progression</button>
            <button type="button" class="quiet-button" data-main-options>Options</button>
            <button type="button" class="quiet-button main-menu-patch-notes" data-open-patch-notes>Patch Notes · 1.0.1</button>
            <div data-main-menu-actions></div>
            <p data-main-status role="status"></p>
        </div>
        <section class="ember-camp" data-ember-camp hidden role="dialog" aria-modal="true" aria-labelledby="ember-camp-title">
            <div class="ember-camp-card">
                <h2 id="ember-camp-title">Ember Camp</h2>
                <p class="ember-camp-balance" data-camp-balance></p>
                <div class="ember-camp-nodes" data-camp-nodes></div>
                <h3>Class mastery</h3>
                <div class="ember-camp-mastery" data-camp-mastery></div>
                <button type="button" class="ember-button" data-close-camp>Back</button>
            </div>
        </section>
    </section>
    <dialog class="save-slots-dialog" data-save-slots-dialog aria-labelledby="save-slots-title">
        <section class="save-slots-card">
            <p class="eyebrow">THE ARCHIVE</p>
            <h2 id="save-slots-title" data-save-slots-title>Choose a save</h2>
            <p data-save-slots-hint>Select a run to continue.</p>
            <div class="save-slot-list" data-save-slot-list aria-label="Save slots"></div>
            <button type="button" class="quiet-button" data-save-slots-cancel>Cancel</button>
        </section>
    </dialog>
    <button type="button" class="quiet-button main-menu-return" data-open-main-menu>Main menu</button>
    <button type="button" class="quiet-button campaign-lore-return" data-open-lore>Chapter lore</button>
    <section class="campaign-lore" data-lore-reader hidden role="dialog" aria-modal="true" aria-labelledby="lore-title">
        <article class="campaign-lore-card">
            <p class="eyebrow" data-lore-chapter></p>
            <h2 id="lore-title" data-lore-title></h2>
            <p data-lore-story></p>
            <h3 data-lore-boss></h3>
            <p data-lore-boss-story></p>
            <p data-lore-tactics></p>
            <p data-lore-ending></p>
            <button type="button" class="ember-button" data-close-lore>Continue campaign</button>
        </article>
    </section>
    <header class="game-header">
        <a class="brand" href="/" aria-label="Path of Boredom home"><span class="brand-mark">&#9671;</span> PATH <small>OF</small> BOREDOM</a>
        <span class="edition"><span data-stat="mode">THE EMBER CAMPAIGN</span> <span>&middot;</span> <span data-stat="campaign">MAP 1 / 6</span></span>
        <div class="signed-in-user" title="@windowsUserName"><small>@(Session is ICloudGameSession ? "PLAYER ACCOUNT" : "WINDOWS SIGN-IN")</small><strong>@windowsUserName</strong></div>
        <div class="game-actions">
            <a class="quiet-button" href="/rankings" target="_blank" rel="noopener">Rankings ↗</a>
            <button type="button" class="quiet-button" data-action="forge" disabled>Forge</button>
            <button type="button" class="quiet-button" data-action="save" disabled>Save</button>
            <button type="button" class="quiet-button" data-action="load" disabled>Load</button>
            <button type="button" class="quiet-button" data-action="pause" disabled>Pause <kbd>P</kbd></button>
        </div>
    </header>
    @if (Session is not ICloudGameSession)
    {
    <aside class="patch-notice" data-patch-notice role="status">
        <span><strong>Version 1.0.1</strong> · Combat balance, save improvements, clearer menus, and bug fixes.</span>
        <a href="/patch-notes#version-1-0-1" target="_blank" rel="noopener">Read patch notes ↗</a>
        <button type="button" class="quiet-button" data-dismiss-patch aria-label="Dismiss patch announcement">Dismiss</button>
    </aside>
    }
    <p class="save-status" data-save-status role="status" aria-live="polite">Saves belong to your signed-in Windows account. Checkpoints save automatically; manual Save/Load is also available.</p>
    <p class="save-status" data-ranking-status role="status">@rankingStatus</p>

    <main class="game-shell">
        <section class="chapter-heading" aria-labelledby="chapter-title">
            <div><p class="eyebrow" data-stat="chapter">CHAPTER I / THE LAST EMBER</p><h1 id="chapter-title" data-stat="map">The Ashen Hollow</h1><p data-stat="map-description">The dead are restless. Give them a reason to stay buried.</p></div>
            <div class="run-record"><span data-stat="difficulty">EASY</span><strong data-stat="score">0</strong><span>RUN SCORE · ENEMIES SLAIN</span></div>
        </section>

        <div class="game-grid">
            <section class="arena-section" aria-label="Game arena">
                <div class="combat-view" data-combat-view>
                <div class="arena-toolbar" aria-label="Arena view controls">
                    <span>Scroll protected during combat · Pause to browse</span>
                    <div>
                        <button type="button" class="quiet-button" data-focus-view aria-pressed="false">Focus view</button>
                        <button type="button" class="quiet-button" data-recenter>Recenter</button>
                        <button type="button" class="quiet-button" data-launch-endless disabled>Endless (locked)</button>
                        <button type="button" class="quiet-button" data-open-skills disabled>Skills &amp; loadout</button>
                        <button type="button" class="quiet-button" data-combat-pause disabled>Pause</button>
                    </div>
                </div>
                <div class="arena-topline"><span><i class="live-dot"></i> <span data-stat="objective">Recover six dawns across 30 waves.</span></span><span>WAVE <strong data-stat="wave">&mdash;</strong> / <strong data-stat="last-wave">30</strong></span></div>
                <div class="combat-pressure" data-stat="pressure" aria-label="Current combat pressure">Threat: awaiting a run</div>
                <div class="arena-viewport">
                    <p class="health-warning" data-health-warning role="status" aria-live="polite"></p>
                    <canvas width="1100" height="650" tabindex="0" aria-label="Action RPG arena. WASD or arrows move. J or left click attacks. Q uses your manual skill. Space dodges, E drinks a flask, and P pauses. Up to three combat skills can cast automatically." aria-describedby="game-controls"></canvas>
                    <div class="arena-overlay" data-overlay>
                        <section class="level-draft" data-level-draft hidden aria-labelledby="level-draft-title">
                            <p class="eyebrow" data-stat="draft-level">LEVEL UP</p>
                            <h2 id="level-draft-title">Choose your next oath</h2>
                            <p class="draft-description">Pick one. Lasts the whole run.</p>
                            <div class="level-card-grid">
                                @for (var index = 0; index < 3; index++)
                                {
                                    <button type="button" class="level-card" data-level-card="@index" disabled>
                                        <img class="level-card-art" data-card-art alt="" aria-hidden="true" />
                                        <span class="card-category" data-card-category></span>
                                        <strong data-card-name></strong>
                                        <span class="card-description" data-card-description></span>
                                        <small data-card-rank></small>
                                        <span class="card-pick">Choose this boon &rarr;</span>
                                    </button>
                                }
                            </div>
                            <p class="draft-footer" data-stat="draft-pending" role="status" aria-live="polite"></p>
                            <button type="button" class="quiet-button draft-reroll" data-card-reroll hidden>Reroll</button>
                            <small>Paused. Offers stay the same after loading.</small>
                        </section>
                        <div class="overlay-card" data-run-menu>
                            <div class="sigil" aria-hidden="true">&#10023;</div>
                            <p class="eyebrow" data-overlay-kicker>SIX DAWNS / ONE LAST PROMISE</p>
                            <h2 data-overlay-title>One blade.<br />One last ember.</h2>
                            <p data-overlay-description>The king rang the Mourning Bell and the sun disappeared. Carry its last spark through six lands. Find your sister. Recover the dawn. Thirty waves, six bosses, then the Endless Watch.</p>
                            <section class="death-report" data-death-report hidden aria-labelledby="death-report-title">
                                <div class="report-panel-heading">
                                    <h3 id="death-report-title">What ended this run?</h3>
                                    <span class="scroll-cue" aria-hidden="true">Scroll for more ↓</span>
                                </div>
                                <div class="report-scroll-region" tabindex="0" aria-label="Death report details">
                                    <p data-killing-blow></p>
                                    <p>Last hits taken (8 s):</p>
                                    <ol data-damage-history></ol>
                                </div>
                            </section>
                            <section class="camp-event" data-camp-event hidden aria-labelledby="camp-event-title">
                                <h3 id="camp-event-title">✦ Stranger at camp: <span data-camp-event-name></span></h3>
                                <p class="camp-challenge-help" data-camp-event-detail></p>
                                <div class="camp-event-actions" data-camp-event-actions>
                                    <button type="button" class="quiet-button camp-event-accept" data-stage-event-accept>Accept bargain</button>
                                    <button type="button" class="quiet-button" data-stage-event-skip>Pass by</button>
                                </div>
                            </section>
                            <section class="camp-challenge" data-camp-challenge hidden aria-labelledby="camp-challenge-title">
                                <h3 id="camp-challenge-title">⚔ Optional challenge for the next stage</h3>
                                <p class="camp-challenge-help">Keep this rule until the next boss dies to earn <strong data-camp-challenge-reward></strong>. Breaking it forfeits the bonus.</p>
                                <div class="camp-challenge-grid" role="group" aria-label="Choose a stage challenge">
                                    <button type="button" class="quiet-button" data-challenge-choice="unscarred"><strong>Unscarred</strong><small>No health damage</small></button>
                                    <button type="button" class="quiet-button" data-challenge-choice="flaskless"><strong>Flaskless</strong><small>Use no flasks</small></button>
                                    <button type="button" class="quiet-button" data-challenge-choice="swift"><strong>Swift</strong><small>Clear within 180s</small></button>
                                    <button type="button" class="quiet-button" data-challenge-choice="blitz"><strong>Blitz</strong><small>120s · +50% gold</small></button>
                                    <button type="button" class="quiet-button" data-challenge-choice="steadfast"><strong>Steadfast</strong><small>Lose under half HP</small></button>
                                    <button type="button" class="quiet-button" data-challenge-choice="ascetic"><strong>Ascetic</strong><small>No flasks · 240s · +50% gold</small></button>
                                    <button type="button" class="quiet-button" data-challenge-choice="none"><strong>No challenge</strong><small>Play normally</small></button>
                                </div>
                                <p class="camp-challenge-status" data-camp-challenge-status role="status"></p>
                            </section>
                            <button type="button" class="ember-button" data-action="start" disabled>Begin the journey <span>&rarr;</span></button>
                            <button type="button" class="ember-button endless-button" data-action="endless" hidden>Abandon run &amp; restart</button>
                            <button type="button" class="quiet-button restart-button" data-action="restart" hidden>Abandon run &amp; restart</button>
                            <dialog class="restart-mode-overlay"
                                    data-restart-mode-chooser
                                    hidden
                                    aria-labelledby="restart-mode-title">

                                <div class="overlay-card restart-mode-card">
                                    <p class="eyebrow">A NEW JOURNEY</p>

                                    <h2 id="restart-mode-title">Choose your path</h2>

                                    <p>
                                        Start a new run. Your current run will be replaced
                                        when you complete the new-run setup.
                                    </p>

                                    <div class="restart-mode-options">
                                        <button type="button"
                                                class="ember-button"
                                                data-restart-mode="campaign">
                                            New Campaign
                                        </button>

                                        <button type="button"
                                                class="ember-button endless-button"
                                                data-restart-mode="endless"
                                                hidden>
                                            New Endless Run
                                        </button>
                                    </div>

                                    <button type="button"
                                            class="quiet-button"
                                            data-restart-cancel>
                                        Cancel
                                    </button>
                                </div>
                            </dialog>
                            <button type="button" class="quiet-button restart-button" data-death-main-menu hidden>Main menu</button>
                            <section class="death-report run-summary" data-run-summary hidden>
                                <div class="run-summary-overview">
                                    <div class="run-summary-heading">
                                        <h4>Run overview</h4>
                                        <span class="scroll-cue" aria-hidden="true">Scroll for more ↓</span>
                                    </div>
                                    <div class="run-summary-scroll" tabindex="0" aria-label="Run overview details">
                                        <ul data-summary-overview></ul>
                                    </div>
                                </div>

                                <div class="run-summary-damage">
                                    <div class="run-summary-heading">
                                        <h4>Damage dealt</h4>
                                        <span class="scroll-cue" aria-hidden="true">Scroll for more ↓</span>
                                    </div>
                                    <div class="run-summary-scroll" tabindex="0" aria-label="Damage dealt details">
                                        <ul data-summary-damage></ul>
                                    </div>
                                </div>
                            </section>
                            <details class="run-build-details">
                                <summary>Run synergies &amp; relics</summary>
                                <p data-build-synergy></p>
                                <p data-boss-relics></p>
                                <div class="run-relic-list" data-run-relics aria-label="Relics collected this run"></div>
                            </details>
                            <small class="unlock-note" data-stat="unlock">Beat the campaign to unlock Endless Watch.</small>
                            <small class="checkpoint-note" data-stat="checkpoint-save"></small>
                            <button type="button" class="ember-button checkpoint-retry" data-retry-save hidden>Retry checkpoint save</button>
                            <small data-loading role="status">Preparing the hollow...</small>
                        </div>
                    </div>
                    <div class="arena-overlay skill-choice-overlay" data-skill-choice hidden role="dialog" aria-modal="true" aria-labelledby="skill-choice-title">
                        <section class="overlay-card">
                            <p class="eyebrow">BUILD YOUR PATH</p>
                            <h2 id="skill-choice-title">Choose your next skill</h2>
                            <p data-skill-choice-description>Locked for this run.</p>
                            <div class="run-skill-pool">
                                @foreach (var skill in CombatSkills)
                                {
                                    <button type="button" class="quiet-button" data-choose-run-skill="@skill">
                                        <img class="run-skill-icon" data-skill-icon="@skill" alt="" />
                                        <strong data-skill-name="@skill">@skill</strong>
                                        <span data-skill-description="@skill"></span>
                                    </button>
                                }
                            </div>
                        </section>
                    </div>
                    <div class="arena-overlay setup-overlay" data-setup hidden role="dialog" aria-modal="true" aria-labelledby="setup-title">
                        <section class="overlay-card">
                            <p class="eyebrow" data-setup-step>PREPARE YOUR JOURNEY</p>
                            <h2 id="setup-title" data-setup-title>Choose your challenge</h2>
                            <p data-setup-description></p>
                            <label class="difficulty-picker" data-setup-difficulty>Difficulty
                                <select data-difficulty aria-describedby="difficulty-description">
                                    <option value="hard">Easy — gentler enemy damage and fuller healing</option>
                                    <option value="nightmare" selected>Medium — recommended challenge</option>
                                    <option value="inferno">Hard — most demanding, least healing</option>
                                </select>
                                <small id="difficulty-description" data-difficulty-description aria-live="polite"></small>
                            </label>
                            <label class="difficulty-picker" data-class-picker>Character class
                                <select data-hero-class aria-describedby="class-preview-description">
                                    <option value="knight">Ember Knight — balanced melee</option>
                                    <option value="ranger">Dawn Ranger — ranged skirmisher</option>
                                    <option value="warden">Iron Warden — armored bruiser</option>
                                    <option value="sorcerer">Astral Sorcerer — fragile spellcaster</option>
                                </select>
                            </label>
                            <section class="class-preview" data-class-preview aria-live="polite">
                                <h3 data-class-title>Ember Knight</h3>
                                <p id="class-preview-description" data-class-description></p>
                                <p data-class-stats></p>
                                <p data-class-skills></p>
                                <small>Base stats before equipment and upgrades. Class stays with the character, including continuation into Endless.</small>
                            </section>
                            <section data-setup-loadout hidden aria-label="Starting skill loadout">
                                <p data-setup-unlock></p>
                                <div class="loadout-grid">
                                    @for (var slot = 0; slot < 1; slot++)
                                    {
                                        <label>Starting automatic skill
                                            <select data-setup-slot="@slot" hidden>
                                                <option value="none">Choose your first skill</option>
                                                @foreach (var skill in StarterSkills)
                                                {
                                                    <option value="@skill" data-setup-skill="@skill">@skill</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                </div>
                                <div class="starter-skill-pool" role="group" aria-label="Choose your starting skill">
                                    @foreach (var skill in StarterSkills)
                                    {
                                        <button type="button" class="quiet-button" data-choose-starter-skill="@skill" aria-pressed="false">
                                            <img class="run-skill-icon" alt="" />
                                            <span data-starter-skill-name>@skill</span>
                                        </button>
                                    }
                                </div>
                                <label class="difficulty-picker">Stage challenge (optional bonus gold)
                                    <select data-setup-challenge>
                                        <option value="none">No challenge</option>
                                        <option value="unscarred">Unscarred — take no health damage</option>
                                        <option value="flaskless">Flaskless — drink no flasks</option>
                                        <option value="swift">Swift — clear within 180 combat seconds</option>
                                        <option value="blitz">Blitz — clear within 120 combat seconds (+50% gold)</option>
                                        <option value="steadfast">Steadfast — lose under half max health</option>
                                        <option value="ascetic">Ascetic — no flasks, within 240 seconds (+50% gold)</option>
                                    </select>
                                </label>
                                <p class="forge-feedback" data-setup-loadout-feedback role="status"></p>
                            </section>
                            <button type="button" class="ember-button" data-setup-next>Continue</button>
                            <button type="button" class="quiet-button restart-button" data-setup-skip hidden>Skip tips &amp; choose skills</button>
                            <button type="button" class="quiet-button restart-button" data-setup-cancel>Cancel</button>
                        </section>
                    </div>
                    <div class="arena-caption" data-stat="map-caption" aria-hidden="true">THE ASHEN HOLLOW / ASHBOUND SANCTUM</div>
                    <div class="forge-nudge" data-forge-nudge hidden><span data-stat="forge-hint" role="status"></span><button type="button" class="quiet-button" data-open-forge>Open forge</button></div>
                    <div class="forge-nudge skill-unlock-nudge" data-skill-unlock hidden>
                        <span data-stat="skill-unlock-hint" role="status"></span>
                        <button type="button" class="quiet-button" data-slot-unlocked>Slot skill</button>
                        <button type="button" class="quiet-button" data-dismiss-unlock aria-label="Dismiss skill unlock reminder">Later</button>
                    </div>
                    <div class="forge-nudge challenge-nudge" data-challenge-nudge hidden>
                        <span role="status"><strong>⚔ New challenge available! The game waits for your choice.</strong> <span data-challenge-nudge-text></span></span>
                        <button type="button" class="quiet-button" data-open-challenges>View challenges</button>
                        <button type="button" class="quiet-button" data-dismiss-challenges aria-label="Dismiss challenge reminder">Skip &amp; continue</button>
                    </div>
                </div>
                <div class="power-strip" aria-label="Active timed power-ups"><span>EMBER BLESSINGS</span><strong data-stat="buffs">No active power-ups</strong></div>
                <div class="vitals">
                    <div class="vital"><div><span>VITALITY</span><strong data-stat="health">100 / 100</strong></div><meter data-meter="health" min="0" max="100" value="100" aria-label="Health"></meter></div>
                    <div class="level-medallion"><small>LVL</small><strong data-stat="level">1</strong></div>
                    <div class="vital experience"><div><span>EXPERIENCE</span><strong data-stat="xp">0 / 60</strong></div><meter data-meter="xp" min="0" max="60" value="0" aria-label="Experience"></meter></div>
                </div>
                <div class="skill-bar">
                    @foreach (var skill in AllSkills)
                    {
                        <button type="button" data-skill="@skill"><kbd data-slot-label></kbd><span class="skill-icon">&#10023;</span><span><span data-skill-name="@skill">@skill</span><small data-stat="@skill">Ready</small></span></button>
                    }
                </div>
                <div class="touch-movement" aria-label="Touch movement controls">
                    <button type="button" data-move="up" aria-label="Move up">&uarr;</button>
                    <div><button type="button" data-move="left" aria-label="Move left">&larr;</button><button type="button" data-move="down" aria-label="Move down">&darr;</button><button type="button" data-move="right" aria-label="Move right">&rarr;</button></div>
                </div>
                </div>
                <section class="skills-panel" data-skills aria-labelledby="skills-title">
                    <div class="forge-heading"><h2 id="skills-title">Paths of power</h2><strong data-stat="skill-points">0 points available</strong></div>
                    <p>Skills cast automatically. New skill at levels 10 and 20. 1 point every 2 levels.</p>
                    <div class="loadout-grid">
                        @for (var slot = 1; slot <= 3; slot++)
                        {
                            <label><span data-loadout-label="@slot">@($"Auto slot {slot}")</span>
                                <select data-loadout-slot="@slot" disabled>
                                    <option value="none">Choose when unlocked</option>
                                    @foreach (var skill in CombatSkills)
                                    {
                                        <option value="@skill" data-skill-name="@skill">@skill</option>
                                    }
                                </select>
                            </label>
                        }
                    </div>
                    <p class="forge-feedback" data-skill-feedback role="status">Chosen skills are locked for this run.</p>
                    <p class="skill-unlock-status" data-stat="ward-unlock-status"></p>
                    <p>Reset a tree for 100 gold + 50 per point.</p>
                    <details class="elite-guide">
                        <summary>Elite traits — appearing from wave 11</summary>
                        <p>Some elites carry one trait, shown above their head with a colored symbol.</p>
                        <ul><li>⬡ Armored: takes 20% less damage; no reflection.</li><li>» Swift: walks 18% faster; charges and attack warnings stay unchanged.</li><li>+ Mending: heals 1.5% maximum health per second; focus it down.</li></ul>
                    </details>
                    <button type="button" class="ember-button" data-resume-combat disabled>Return to battle</button>
                    <div class="skill-tree-grid">
                        @foreach (var skill in AllSkills)
                        {
                            <section class="skill-tree" data-tree-skill="@skill" hidden="@CombatSkills.Contains(skill)">
                                <h3 data-skill-name="@skill">@skill</h3>
                                <p data-skill-description="@skill"></p>
                                <p class="tree-path">Select once to inspect. Select again while Available to learn; each rank costs 1 point.</p>
                                <button type="button" class="quiet-button tree-respec" data-respec-tree="@skill" disabled>Reset tree</button>
                                <div class="skill-tree-map" role="group" aria-label="Upgrade branches">
                                    <svg class="tree-connections" viewBox="0 0 300 300" preserveAspectRatio="none" aria-hidden="true">
                                        <path data-tree-link="root-left" d="M150 40 L75 150" />
                                        <path data-tree-link="root-right" d="M150 40 L225 150" />
                                        <path data-tree-link="left-capstone" d="M75 150 L150 260" />
                                        <path data-tree-link="right-capstone" d="M225 150 L150 260" />
                                    </svg>
                                    @foreach (var node in new[] { "root", "left", "right", "capstone" })
                                    {
