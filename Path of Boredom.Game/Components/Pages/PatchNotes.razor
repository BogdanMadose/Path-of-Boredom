@page "/patch-notes"
@layout GameLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@if (!Embedded)
{
    <PageTitle>Version 1.0.1 · Path of Boredom</PageTitle>
}

<main class="patch-notes @(Embedded ? "embedded" : null)">
    @if (!Embedded)
    {
        <header class="page-header">
            <a class="brand" href="/">PATH <small>OF</small> BOREDOM</a>
            <nav aria-label="Main navigation">
                <a href="/">Game</a>
                <a href="/rankings">Rankings</a>
                <a href="/patch-notes" aria-current="page">Patch notes</a>
            </nav>
        </header>
        <section class="page-heading">
            <p class="eyebrow">LATEST UPDATE</p>
            <h1>Patch Notes</h1>
            <p>Changes and improvements in version 1.0.1.</p>
        </section>
    }

    <article id="version-1-0-1">
        <header class="patch-heading">
            <div class="patch-meta">
                <span class="badge">VERSION 1.0.1</span>
                <span class="badge latest">LATEST UPDATE</span>
            </div>
            <h2>More room to save your journey</h2>
            <p>This update brings a redesigned main menu, makes it easier to manage runs, sharpens the Forge presentation, and smooths out a few parts of the game.</p>
            <div class="tags" aria-label="Update highlights">
                <span>Main menu</span><span>Save slots</span><span>Forge artwork</span><span>Challenge saves</span><span>Game polish</span>
            </div>
        </header>

        <nav class="contents" aria-label="Version 1.0.1 contents">
            <a href="#main-menu">Main menu</a>
            <a href="#save-slots">Save slots</a>
            <a href="#forge-artwork">Forge artwork</a>
            <a href="#challenge-saves">Challenge saves</a>
            <a href="#difficulty-and-restart">Difficulty and restart</a>
        </nav>

        <section class="patch-section" id="main-menu">
            <p class="eyebrow">A NEW WAY TO SET OUT</p>
            <h3>Meet the improved main menu</h3>
            <p>The refreshed menu brings Continue, Play, Load saved run, Account Progression, and Options together in one place. Open Play to start a Campaign or enter Endless when it is unlocked.</p>
        </section>

        <section class="patch-section" id="save-slots">
            <p class="eyebrow">YOUR ADVENTURE</p>
            <h3>Choose which run to continue</h3>
            <ul>
                <li>Save up to five runs and choose a save when you load.</li>
                <li>Each save shows its class and run details, so it is easy to find the right adventure.</li>
                <li>Autosaves stay with the selected run, and existing saves are kept when moving to the new save system.</li>
            </ul>
        </section>

        <section class="patch-section" id="forge-artwork">
            <p class="eyebrow">AT THE FORGE</p>
            <h3>Upgrade and mastery cards get artwork</h3>
            <p>Forge upgrades and masteries now have their own artwork, giving each choice more visual character as you shape your build.</p>
        </section>

        <section class="patch-section" id="challenge-saves">
            <p class="eyebrow">CHALLENGE RUNS</p>
            <h3>Challenge selections save correctly</h3>
            <p>Starting a new stage challenge no longer causes the save to fail. Your selected challenge and run can be saved as expected.</p>
        </section>

        <section class="patch-section" id="difficulty-and-restart">
            <p class="eyebrow">A CLEARER, CLEANER FLOW</p>
            <h3>Updated difficulty names and restart options</h3>
            <ul>
                <li>Difficulty choices are now named Easy, Medium, and Hard. The existing gameplay tuning is unchanged.</li>
                <li>The restart action has a simpler label, and its options now sit in a compact panel while the screen behind them remains blurred.</li>
            </ul>
        </section>
    </article>

    @if (!Embedded)
    {
        <footer>
            <span>Version 1.0.1 · Path of Boredom</span>
            <a href="/">Return to the game</a>
        </footer>
    }
</main>

@code {
    [Parameter] public bool Embedded { get; set; }
}
