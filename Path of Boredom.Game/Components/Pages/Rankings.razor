@page "/rankings"
@layout GameLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using Path_of_Boredom.ServiceDefaults
@inject IGameSession Session

@if (!Embedded)
{
    <PageTitle>Hall of Embers · Path of Boredom</PageTitle>
}

<main class="rankings @(Embedded ? "embedded" : null)">
    <header>
        <a href="/">◇ PATH OF BOREDOM</a>
        <a href="/patch-notes">Patch notes</a>
        <span>THE WATCH REMEMBERS</span>
    </header>
    <section class="heading">
        <p class="eyebrow">HALL OF EMBERS</p>
        <h1>Those who held the dawn</h1>
        <p>Every fallen enemy counts. Each class keeps its own highest kill score for every difficulty and starting mode, even after death. Inspect a record to see the upgrades used in that build.</p>
    </section>
    <div class="filters">
        <label>Patch
            <select @bind="patch" @bind:after="RefreshAsync" disabled="@busy">
                <option value="004">Patch 004 — fresh runs</option>
                <option value="pre004">Pre-004 / inherited runs</option>
            </select>
        </label>
        <label>Difficulty
            <select @bind="difficulty" @bind:after="RefreshAsync" disabled="@busy">
                <option value="hard">@RankingRules.DifficultyName("hard")</option>
                <option value="nightmare">@RankingRules.DifficultyName("nightmare")</option>
                <option value="inferno">@RankingRules.DifficultyName("inferno")</option>
            </select>
        </label>
        <label>Starting mode
            <select @bind="mode" @bind:after="RefreshAsync" disabled="@busy">
                <option value="campaign">Campaign journey</option>
                <option value="endless">Veteran Endless start</option>
                <option value="ascended">Endless after campaign</option>
            </select>
        </label>
        <label>Class
            <select @bind="heroClass" @bind:after="RefreshAsync" disabled="@busy">
                <option value="all">All class boards</option>
                <option value="knight">Ember Knight</option>
                <option value="ranger">Dawn Ranger</option>
                <option value="warden">Iron Warden</option>
            </select>
        </label>
        <button type="button" data-rankings-refresh @onclick="RefreshAsync" disabled="@busy">Refresh</button>
    </div>
    <p class="notice">Ranks and ties are calculated within each patch and class. New campaigns and fresh veteran Endless runs qualify for Patch 004. Saves from before patch tracking stay on the archive boards, including when continued into Endless, so inherited power cannot compete with fresh builds. Existing records are preserved. Legacy unranked saves remain unranked.</p>
    <p class="notice">Build details are captured when a higher score is submitted; later upgrades or tied scores do not rewrite that record. Older records keep their recorded class, but upgrades and discarded scores from other classes cannot be recovered.</p>
    @if (busy)
    {
        <p role="status">Gathering the names of the watch...</p>
    }
    else if (error is not null)
    {
        <p class="error" role="alert">@error</p>
    }
    else if (rows.Count == 0)
    {
        <p class="ranking-status">@(Embedded && !loaded ? "Refresh to load the online boards. Your current game stays paused." : "No players yet. Begin your journey to leave a mark.")</p>
    }
    else
    {
        @foreach (var board in rows.GroupBy(row => row.HeroClass))
        {
            <section class="class-board" @key="board.Key" aria-label="@RankingRules.ClassName(board.Key)">
                <h2>@RankingRules.ClassName(board.Key)</h2>
                @if (Embedded)
                {
                    <div class="ranking-cards">
                        @foreach (var row in board)
                        {
                            <article class="ranking-card @(row.IsCurrentUser ? "current" : null)">
                                <div class="record-heading">
                                    <span class="rank">#@row.Rank</span>
                                    <strong>@row.Player @if (row.IsCurrentUser) { <small>YOU</small> }</strong>
                                    <span class="score">@row.Score.ToString("N0")</span>
                                </div>
                                @if (row.Build is { } build)
                                {
                                    <details class="build-details">
                                        <summary>Level @build.Level · Build details</summary>
                                        <p><strong>Manual:</strong> @build.ManualSkill<br /><strong>Auto:</strong> @(build.AutoSkills.Count == 0 ? "None" : string.Join(", ", build.AutoSkills))</p>
                                        @foreach (var group in build.Upgrades.GroupBy(upgrade => upgrade.Category))
                                        {
                                            <h3>@RankingRules.UpgradeCategory(group.Key)</h3>
                                            <ul>
                                                @foreach (var upgrade in group)
                                                {
                                                    <li>@upgrade.Name <strong>rank @upgrade.Rank.ToString("N0")</strong></li>
                                                }
                                            </ul>
                                        }
                                    </details>
                                }
                                else
                                {
                                    <span class="build-unavailable">Build not recorded</span>
                                }
                            </article>
                        }
                    </div>
                }
                else
                {
                <div class="table-scroll" role="region" aria-label="@(RankingRules.ClassName(board.Key) + " rankings")" tabindex="0">
                    <table>
                        <caption>@RankingRules.PatchName(patch) · @RankingRules.DifficultyName(difficulty) · @(mode == "campaign" ? "CAMPAIGN JOURNEY" : mode == "ascended" ? "ENDLESS AFTER CAMPAIGN" : "VETERAN ENDLESS") · @board.Count() players</caption>
                        <thead><tr><th scope="col">Rank</th><th scope="col">Ashbound</th><th scope="col">Best score</th><th scope="col">Upgrades at record</th><th scope="col">Record set (UTC)</th></tr></thead>
                        <tbody>
                            @foreach (var row in board)
                            {
                                <tr class="@(row.IsCurrentUser ? "current" : null)">
                                    <td><span class="rank">#@row.Rank</span></td>
                                    <th scope="row">@row.Player @if (row.IsCurrentUser) { <small>YOU</small> }</th>
                                    <td class="score">@row.Score.ToString("N0")</td>
                                    <td class="build-cell">
                                        @if (row.Build is { } build)
                                        {
                                            <details class="build-details">
                                                <summary>Level @build.Level · View upgrades (@build.Upgrades.Count)</summary>
                                                <p><strong>Manual (Q):</strong> @build.ManualSkill<br /><strong>Auto:</strong> @(build.AutoSkills.Count == 0 ? "None" : string.Join(", ", build.AutoSkills))</p>
                                                @if (build.Upgrades.Count == 0)
                                                {
                                                    <p>No upgrades taken yet.</p>
                                                }
                                                @foreach (var group in build.Upgrades.GroupBy(upgrade => upgrade.Category))
                                                {
                                                    <h3>@RankingRules.UpgradeCategory(group.Key)</h3>
                                                    <ul>
                                                        @foreach (var upgrade in group)
                                                        {
                                                            <li>@upgrade.Name <strong>rank @upgrade.Rank.ToString("N0")</strong></li>
                                                        }
                                                    </ul>
                                                }
                                            </details>
                                        }
                                        else
                                        {
                                            <span class="build-unavailable">@(row.AchievedAt is null ? "No run yet" : "Not recorded for this older score")</span>
                                        }
                                    </td>
                                    <td>@(row.AchievedAt?.UtcDateTime.ToString("yyyy-MM-dd HH:mm") ?? "Not played yet")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }
            </section>
        }
    }
    <footer>Developed by MadBone | LIT MES TSR <span>Community rankings · browser-reported scores, not cheat-proof</span></footer>
</main>

@code {
    [Parameter] public bool Embedded { get; set; }
    private bool loaded;
    // Filter state bound directly to the <select> elements above via @bind:after — changing any
    // filter immediately triggers RefreshAsync rather than needing a separate "apply" step.
    private string difficulty = "hard";
    private string mode = "campaign";
    private string heroClass = "all";
    private string patch = RankingRules.CurrentPatch;
    private bool busy;
    private string? error;
    private IReadOnlyList<RankingRow> rows = [];

    /// <summary>Loads the default (Hard / Campaign / All classes / current patch) leaderboard on first render.</summary>
    protected override Task OnInitializedAsync() => Embedded ? Task.CompletedTask : RefreshAsync();

    /// <summary>
    /// Re-registers the player's ranking profile (cheap, idempotent — also doubles as a
    /// connectivity check to the API) and then fetches the leaderboard for the current filter
    /// selection. Guards against overlapping calls with the <see cref="busy"/> flag, since rapid
    /// filter changes could otherwise fire several requests whose responses might race each other.
    /// </summary>
    private async Task RefreshAsync()
    {
        if (busy) return;
        busy = true;
        error = null;
        try
        {
            if (!await Session.RegisterPlayerAsync())
            {
                error = Embedded
                    ? "Online rankings are unavailable. The mobile offline preview does not connect to the leaderboard yet; your current game remains paused."
                    : "Rankings are unavailable. Please try Refresh again shortly.";
                return;
            }
            var result = await Session.GetRankingsAsync(difficulty, mode, heroClass, patch);
            if (result is null) error = "Could not load rankings. Please try again shortly.";
            else { rows = result; loaded = true; }
        }
        catch
        {
            error = "Could not reach the rankings service. You can return to your game and try again later.";
        }
        finally { busy = false; }
    }
}