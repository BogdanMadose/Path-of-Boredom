<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@(new[] { typeof(IGameSession).Assembly })">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Path_of_Boredom.Game.Components.Layout.GameLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <main>
            <h1>Page not found</h1>
            <p>The requested page could not be found.</p>
        </main>
    </NotFound>
</Router>
