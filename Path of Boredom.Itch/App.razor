<Router AppAssembly="@typeof(App).Assembly" AdditionalAssemblies="@(new[] { typeof(IGameSession).Assembly })">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Path_of_Boredom.Game.Components.Layout.GameLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        @* itch.io loads the build as ".../index.html", which matches no route: show the game. *@
        <LayoutView Layout="@typeof(Path_of_Boredom.Game.Components.Layout.GameLayout)">
            <Path_of_Boredom.Game.Components.Pages.Home />
        </LayoutView>
    </NotFound>
</Router>
