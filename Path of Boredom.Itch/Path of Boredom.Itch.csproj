<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Version>1.0.2</Version>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Space-free, like the Game and MAUI projects: static web asset endpoint keys break on spaces,
         and index.html references the PathOfBoredom.Itch.styles.css bundle by this name. -->
    <AssemblyName>PathOfBoredom.Itch</AssemblyName>
    <RootNamespace>Path_of_Boredom.Itch</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.22" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Path of Boredom.Game\Path of Boredom.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Pages\" />
  </ItemGroup>

  <Target Name="PackageItchUpload" AfterTargets="Publish">
    <PropertyGroup>
      <ItchPackageDirectory>$(MSBuildProjectDirectory)\bin\$(Configuration)\itch</ItchPackageDirectory>
    </PropertyGroup>
    <Error Condition="!Exists('$(PublishDir)wwwroot/index.html')" Text="Itch publish output is missing wwwroot/index.html." />
    <MakeDir Directories="$(ItchPackageDirectory)" />
    <ZipDirectory SourceDirectory="$(PublishDir)wwwroot" DestinationFile="$(ItchPackageDirectory)\PathOfBoredom-Itch.zip" Overwrite="true" />
    <Message Importance="high" Text="Upload $(ItchPackageDirectory)\PathOfBoredom-Itch.zip to itch.io as an HTML game." />
  </Target>

</Project>
