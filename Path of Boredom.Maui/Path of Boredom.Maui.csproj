<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Version>1.0.2</Version>
    <!-- iOS only enters the build on a Mac (or a Windows box paired to one). Including it
         unconditionally would break `dotnet build` of the solution on a plain Windows dev machine,
         which is where this project is actually developed. Android is the shipping target for now;
         iOS stays wired up so it can be built later without restructuring. -->
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Space-free, for the same reason as Path of Boredom.Game: the static web asset pipeline
         builds endpoint keys from the assembly name and spaces collide. -->
    <AssemblyName>PathOfBoredom.Maui</AssemblyName>
    <RootNamespace>Path_of_Boredom.Maui</RootNamespace>

    <ApplicationTitle>Path of Boredom</ApplicationTitle>
    <!-- Reverse-DNS id. This is permanent once published: Google Play keys a listing to it and it
         can never be changed or reused afterwards. -->
    <ApplicationId>com.madbone.pathofboredom</ApplicationId>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>3</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Platforms/iOS/Entitlements.plist</CodesignEntitlements>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
    <CodesignEntitlements Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>

    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0b0a10" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0b0a10" BaseSize="128,128" />
    <MauiAsset Include="Resources\Raw\play-games-achievements.json" LogicalName="play-games-achievements.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="9.0.110" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.11" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" Version="122.0.0" />
	<PackageReference Include="Xamarin.GooglePlayServices.Games.V2" Version="122.1.0" />
	<PackageReference Include="Xamarin.AndroidX.Fragment.Ktx" Version="1.9.0" />
	<!-- Pinned to the versions NuGet resolves transitively, to clear NU1608 constraint warnings. -->
	<PackageReference Include="Xamarin.AndroidX.Collection.Ktx" Version="1.6.0.1" />
	<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.11.0.1" />
	<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.11.0.1" />
	<PackageReference Include="Xamarin.AndroidX.Credentials" Version="1.6.0.1" />
	<PackageReference Include="Xamarin.AndroidX.Credentials.PlayServicesAuth" Version="1.6.0.2" />
	<PackageReference Include="Xamarin.Google.Android.Libraries.Identity.GoogleId" Version="1.1.0.16" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' And '$(Configuration)' == 'Release'">
    <!-- Universal (Apple silicon + Intel) Mac App Store build. -->
    <RuntimeIdentifiers>maccatalyst-arm64;maccatalyst-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
    <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup>
    <!-- Balance-test output, not app content (iOS rejects it as bundle resources). -->
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <BundleResource Remove="tests\**" />
    <MauiAsset Remove="tests\**" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <!-- Apple privacy manifest; required for App Store submission. -->
    <BundleResource Include="Platforms\iOS\PrivacyInfo.xcprivacy" LogicalName="PrivacyInfo.xcprivacy" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tests\achievement-notifications.test.mjs" />
    <None Include="tests\achievement-overflow.test.mjs" />
    <None Include="tests\achievement-toast-browser.test.mjs" />
    <None Include="tests\achievements.test.mjs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Path of Boredom.Game\Path of Boredom.Game.csproj" />
  </ItemGroup>

</Project>
